# The Don't Panic gate: serves the site and its small API on 127.0.0.1:8788. Edit User= and the paths.
[Unit]
Description=Don't Panic gate (The Hitchhiker's Guide to Trust)
After=network-online.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/dontpanic
Environment=NODE_NAME=Mitch's Pi
ExecStart=/usr/bin/node serve.mjs
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
